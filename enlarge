#!/usr/bin/env bash
# 1. Parse command-line options
REAL_ESRGAN_BIN="./realesrgan-ncnn-vulkan"

while getopts ":p:" opt; do
  case ${opt} in
    p )
      REAL_ESRGAN_BIN="$OPTARG"
      ;;
    \? )
      echo "Invalid option: -$OPTARG" >&2
      ;;
  esac
done
shift $((OPTIND -1))

# 2. Validate input file
if [ $# -lt 1 ]; then
  echo "Usage: $0 [-p <path_to_realesrgan>] <video_file>"
  exit 1
fi

INPUT_VIDEO="$1"

# Detect input format (extension)
INPUT_FORMAT="${INPUT_VIDEO##*.}"
INPUT_FORMAT="${INPUT_FORMAT,,}"  # Convert to lowercase

if [[ "$INPUT_FORMAT" != "mp4" && "$INPUT_FORMAT" != "mkv" ]]; then
  echo "Error: Only MP4 and MKV formats are supported. Got: $INPUT_FORMAT"
  exit 1
fi

# 3. Prepare working directories
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
TMP_FRAMES_DIR="tmp_frames_${TIMESTAMP}"
OUT_FRAMES_DIR="out_frames_${TIMESTAMP}"
mkdir -p "$TMP_FRAMES_DIR" "$OUT_FRAMES_DIR"

# Get video info for framerate
FRAMERATE=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 "$INPUT_VIDEO")

echo "Detected format: $INPUT_FORMAT"
echo "Framerate: $FRAMERATE"

# 4. Extract frames from the input video
echo "Step 1/3: Extracting frames from $INPUT_VIDEO ..."
ffmpeg -i "$INPUT_VIDEO" -qscale:v 1 -qmin 1 -qmax 1 -fps_mode passthrough -threads 0 "${TMP_FRAMES_DIR}/frame%08d.jpg"

# Count total frames
TOTAL_FRAMES=$(find "$TMP_FRAMES_DIR" -type f | wc -l)

if [[ $TOTAL_FRAMES -eq 0 ]]; then
  echo "Error: No frames extracted from $INPUT_VIDEO"
  exit 1
fi

echo "Extracted $TOTAL_FRAMES frames"

# 5. Enhance frames with Real-ESRGAN
echo "Step 2/3: Enhancing frames with Real-ESRGAN..."

"$REAL_ESRGAN_BIN" -i "$TMP_FRAMES_DIR" -o "$OUT_FRAMES_DIR" -n \
  realesr-animevideov3 -s 2 -f jpg > "realesrgan_${TIMESTAMP}.log" 2>&1 &

REAL_ESRGAN_PID=$!

while kill -0 $REAL_ESRGAN_PID 2>/dev/null; do
  PROCESSED=$(find "$OUT_FRAMES_DIR" -type f | wc -l)
  PERCENT=$((PROCESSED * 100 / TOTAL_FRAMES))
  echo -ne "Progress: $PERCENT% ($PROCESSED/$TOTAL_FRAMES)\r"
  sleep 1
done

wait $REAL_ESRGAN_PID
ESRGAN_EXIT_CODE=$?

echo -e "\nProcessing complete!"

if [ $ESRGAN_EXIT_CODE -ne 0 ]; then
  echo "Error: Real-ESRGAN processing failed!"
  echo "Check realesrgan_${TIMESTAMP}.log for details"
  exit 1
fi

# 6. Re-assemble the enhanced frames into a video (format-specific)
echo "Step 3/3: Re-assembling frames into final video..."

OUTPUT_VIDEO="${INPUT_VIDEO%.*}_enhanced.${INPUT_FORMAT}"

if [[ "$INPUT_FORMAT" == "mp4" ]]; then
  # MP4: Use libx264 with yuv420p for compatibility
  ffmpeg -framerate "$FRAMERATE" \
    -i "${OUT_FRAMES_DIR}/frame%08d.jpg" -i "$INPUT_VIDEO" -map 0:v:0 -map 1:a:0 -c:a copy -disposition:v default -disposition:a default -disposition:s 0 -c:v libx264 -pix_fmt yuv420p -preset medium -threads 0 "$OUTPUT_VIDEO" -y

elif [[ "$INPUT_FORMAT" == "mkv" ]]; then
  # MKV: Preserve all streams (audio + subtitles)
  ffmpeg -framerate "$FRAMERATE" -i "${OUT_FRAMES_DIR}/frame%08d.jpg" -i "$INPUT_VIDEO" -map 0:v:0 -map 1:a -map 1:s? -disposition:v default -disposition:a default -disposition:s 0 -c:a copy -c:s copy -c:v libx264 -pix_fmt yuv420p -preset medium -threads 0 "$OUTPUT_VIDEO" -y
fi

if [ $? -ne 0 ]; then
  echo "Error: Video reassembly failed!"
  exit 1
fi

# 7. Clean up
rm -f "realesrgan_${TIMESTAMP}.log"
# Optional: uncomment to delete temp directories
# rm -rf "$TMP_FRAMES_DIR" "$OUT_FRAMES_DIR"

echo "Done! Enhanced video saved as: $OUTPUT_VIDEO"
